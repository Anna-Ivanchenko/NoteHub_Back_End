# --- Server ---
PORT=3000
NODE_ENV=development

# URL фронтенду (для CORS та посилань у листах скидання пароля)
FRONTEND_DOMAIN=http://localhost:3001

# --- MongoDB ---
# Локально: mongodb://127.0.0.1:27017/notehub
# Або кластер MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/notehub
MONGO_URL=

# --- JWT (використовується для токена скидання пароля) ---
JWT_SECRET=change-me-to-a-random-secret

# --- SMTP (лист для скидання пароля) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NoteHub <no-reply@notehub.local>"

# --- Cloudinary (аватарки користувачів) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
